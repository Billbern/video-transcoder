# Production environment for the Hetzner VPS.
# Copy this file to .env on the server (NOT in the repo) and fill in real values.
#
# Compose variables (substituted by docker-compose on the server):
#   REPO_OWNER   - GitHub org/user that owns the GHCR images, e.g. "Billbern"
#   IMAGE_TAG    - tag to pull; default "latest", CI sets it to the short SHA

REPO_OWNER=your-github-org-or-username
IMAGE_TAG=latest

# --- Postgres ----------------------------------------------------------------
# Override the defaults from the compose file with strong credentials.
POSTGRES_USER=vt
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=videotranscoder

# --- S3 / MinIO --------------------------------------------------------------
# In production, point at a real S3-compatible backend (Cloudflare R2, Backblaze
# B2, Wasabi, an AWS bucket, or the bundled MinIO if you keep it).
#   S3_ENDPOINT=""        # leave empty for native AWS / R2
#   S3_ENDPOINT=http://minio:9000  # if you keep the in-cluster MinIO
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_INGEST=raw-videos
S3_BUCKET_OUTPUT=processed-videos
S3_PRESIGN_EXPIRY_SECONDS=3600

# --- Backend (consumed by the API + worker via env_file: .env) --------------
DATABASE_URL=postgresql+asyncpg://vt:change-me-to-a-long-random-string@postgres:5432/videotranscoder
SYNC_DATABASE_URL=postgresql+psycopg2://vt:change-me-to-a-long-random-string@postgres:5432/videotranscoder
REDIS_URL=redis://redis:6379/0
MAX_UPLOAD_BYTES=2147483648

# Comma-separated origins that may call the API from a browser.
# Must include the exact domain Nginx Proxy Manager serves on (no trailing /).
CORS_ORIGINS=https://videotranscode.example.com

LOG_LEVEL=INFO
