# Copy to .env (root) or backend/.env and adjust as needed.

# Database
DATABASE_URL=postgresql+asyncpg://vt:vt@postgres:5432/videotranscoder
SYNC_DATABASE_URL=postgresql+psycopg2://vt:vt@postgres:5432/videotranscoder

# Redis (broker + result backend)
REDIS_URL=redis://redis:6379/0

# Object storage (S3-compatible: MinIO locally, R2/B2 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_INGEST=raw-videos
S3_BUCKET_OUTPUT=processed-videos
S3_PRESIGN_EXPIRY_SECONDS=3600

# Limits
MAX_UPLOAD_BYTES=2147483648

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO

# For tests / local SQLite
USE_SQLITE=0
